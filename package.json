{
  "name": "cha-ching",
  "version": "1.0.0",
  "description": "Courtside trading for NBA, NFL and MLB games on Kalshi: favor a team, buy at the current price, auto-sell at your target.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"test/*.test.js\"",
    "electron": "vite build && electron .",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "ios": "vite build && cap sync ios && cap open ios",
    "dist:desktop": "vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@noble/curves": "^2.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.chaching.app",
    "productName": "Cha-Ching",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance"
    }
  }
}
